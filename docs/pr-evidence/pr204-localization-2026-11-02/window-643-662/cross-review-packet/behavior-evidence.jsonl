{"claim":"The action removes old routing-seen tracking records rather than message bodies.","evidenceId":"E658","pins":[{"excerptSha256":"a429301e11902a6d8c2884461b9084741a44a8c568e7a36c75e38b88eb3a5026","fileBlob":"4e205e85e50775e0d1e69802884f30d6b1c32ed5","fileSha256":"d69c4b642ea560fd3f53688927cce8f6fea9f93923aa89f4924f640631cda32b","firstLine":165,"lastLine":172,"lines":["  const handleCleanupSeenMessages = async () => {","    try {","      const result = await mediacore.cleanupSeenMessages();","      toast.success(","        interfaceText(\"Cleanup completed: {messagesCleaned} messages cleaned, {messagesRetained} retained\", { \"messagesCleaned\": (result.messagesCleaned), \"messagesRetained\": (result.messagesRetained) }),","      );","      // Reload stats to reflect changes","      await handleLoadRoutingStats();"],"path":"web/src/components/System/MediaCore/PodMessageRoutingPanel.jsx"},{"excerptSha256":"7b88109c5c7e395dad4270de8a75fe435292caf3d6bb541fb0bcbbeeb3028968","fileBlob":"c72778defb6068c46681fd405b7b6623b8cce71f","fileSha256":"b20104d3939f16fab87ea46fc1b36974dd129df2b3d159d96f3b098745ee89bd","firstLine":856,"lastLine":862,"lines":["/**"," * Clean up old seen message entries."," */","export const cleanupSeenMessages = async () => {","  return (await api.post(`${podRoutingBaseUrl}/cleanup`)).data;","};",""],"path":"web/src/lib/mediacore.js"},{"excerptSha256":"8300f155c16736b52dd91922819f18931ff0f51de957ec38a3f3a9e77229181a","fileBlob":"09e8252602a617bc76e76bfaafc38cf270acf097","fileSha256":"8de3802d6daaa1239c00a645802a658ef63031b975cc5edadf3d1482f2182a3a","firstLine":1033,"lastLine":1069,"lines":["            if action == \"cleanup\" {","                const ROUTING_WINDOW_MILLIS: u64 = 24 * 60 * 60 * 1_000;","                let started_at = std::time::Instant::now();","                let cutoff = unix_timestamp_millis().saturating_sub(ROUTING_WINDOW_MILLIS);","                let prefix = \"pod/routing-seen/\";","                let entries = state","                    .controller_features","                    .read()","                    .await","                    .entries_with_prefix(prefix);","                let expired_keys = entries","                    .iter()","                    .filter_map(|(key, value)| {","                        let seen_at = value.get(\"seenAt\").and_then(serde_json::Value::as_u64);","                        (seen_at.is_none_or(|seen_at| seen_at < cutoff)).then(|| key.clone())","                    })","                    .collect::<Vec<_>>();","                let retained_before_cleanup = entries.len().saturating_sub(expired_keys.len());","                let removed = match state.controller_features.remove_keys(&expired_keys).await {","                    Ok(removed) => removed,","                    Err(error) => {","                        return Some(podcore_storage_error_response(","                            state,","                            versioned_v0,","                            \"Failed to cleanup seen messages\",","                            &error,","                        ));","                    }","                };","                return Some(routing::ok_response(","                    serde_json::json!({","                        \"messagesCleaned\": removed,","                        \"messagesRetained\": retained_before_cleanup,","                        \"cleanupDuration\": format_timespan_hms(started_at.elapsed().as_secs() as i64),","                        \"completedAt\": chrono::Utc::now().to_rfc3339(),","                    })","                    .to_string(),"],"path":"crates/slskr/src/podcore_mutations.rs"}],"sourceId":"Cleanup Seen Messages","sourceIndex":658}
