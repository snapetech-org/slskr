# This Ruleset is EmergingThreats Open optimized for suricata-7.0.3-enhanced.


alert tcp $EXTERNAL_NET [1024:] -> $HOME_NET [49152:] (msg:"ET MALWARE VenomRAT CnC Server Keepalive"; flow:established,to_client; flowbits:set,ET.VenomRAT; dsize:68; content:"|40 00 00 00|"; depth:4; fast_pattern; content:!"|00 00 00 00|"; within:4; threshold: type both, track by_src, count 10, seconds 120; classtype:command-and-control; sid:2055754; rev:1; metadata:affected_product Windows_XP_Vista_7_8_10_Server_32_64_Bit, affected_product Windows_11, attack_target Client_Endpoint, tls_state plaintext, created_at 2024_09_05, deployment Perimeter, malware_family VenomRAT, confidence High, signature_severity Critical, updated_at 2024_09_05, mitre_tactic_id TA0011, mitre_tactic_name Command_And_Control, mitre_technique_id T1095, mitre_technique_name Non_Application_Layer_Protocol;)
