{
  "name": "@slskr/api-client",
  "version": "1.0.0",
  "description": "TypeScript/JavaScript client library for the slskr HTTP API",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run --globals --maxWorkers=1",
    "test:watch": "vitest --globals",
    "lint": "eslint src",
    "docs": "typedoc src",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "soulseek",
    "slskr",
    "client",
    "api",
    "typescript"
  ],
  "author": "slskr contributors",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "eslint": "^10.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "ws": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "ws": {
      "optional": true
    }
  },
  "overrides": {
    "glob": "14.0.4",
    "js-yaml": "^4.3.1",
    "brace-expansion": "5.0.12",
    "handlebars": "4.7.10",
    "minimatch": "11.0.5"
  }
}
