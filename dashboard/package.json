{
  "name": "slskr-admin-dashboard",
  "version": "1.0.0",
  "description": "Web-based admin dashboard for slskr HTTP API",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint \"src/**/*.{ts,tsx}\" vite.config.ts",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:bundle-budget": "python3 ../scripts/check-web-bundle-budget.py --build-dir dist --initial-js-max-kib 260 --gzip-max-kib 100"
  },
  "dependencies": {
    "axios": "^1.21.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.69.0",
    "react": "~19.2.9",
    "react-dom": "~19.2.9",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.8",
    "@types/jest-axe": "^3.5.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^10.14.0",
    "jest-axe": "^11.0.0",
    "jsdom": "^31.0.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "brace-expansion": "5.0.12",
    "follow-redirects": "1.16.2",
    "minimatch": "11.0.5",
    "glob": "14.0.4"
  }
}
