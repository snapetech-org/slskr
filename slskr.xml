<?xml version="1.0"?>
<Container version="2">
  <Name>slskr</Name>
  <Repository>ghcr.io/snapetech/slskr:latest</Repository>
  <Registry>https://ghcr.io</Registry>
  <Network>bridge</Network>
  <Branch>stable</Branch>
  <Privileged>false</Privileged>
  <Shell>bash</Shell>
  <Icon>https://raw.githubusercontent.com/snapetech-org/slskr/main/web/public/slskr-mark.png</Icon>
  <Overview>Self-hosted Rust Soulseek daemon, HTTP API, and bundled browser UI. One slskr serve process owns the Soulseek session, peer listeners, share index, transfer engine, API, event stream, and Web UI for a private, scriptable Soulseek client.</Overview>
  <Description>Set SLSKR_API_TOKEN for API clients and SLSKD_PASSWORD to replace the default Web UI login (user slskr, password slskr). Shares are served from the Shares path; downloads and incomplete files use the mapped data paths.</Description>
  <WebUI>http://[IP]:[PORT:5030]/</WebUI>
  <Support>https://github.com/snapetech-org/slskr/issues</Support>
  <Project>https://github.com/snapetech-org/slskr</Project>
  <TemplateURL>https://raw.githubusercontent.com/snapetech-org/slskr/main/slskr.xml</TemplateURL>
  <ReadMe>https://raw.githubusercontent.com/snapetech-org/slskr/main/README.md</ReadMe>
  <Discord>https://discord.gg/5PyXBfvS6T</Discord>
  <Category>MediaApp:Music</Category>
  <ExtraSearchTerms>soulseek slskd music p2p shares downloads daemon</ExtraSearchTerms>
  <License>AGPL-3.0-only</License>
  <MinVer>6.12.0</MinVer>
  <Date>2026-10-17</Date>
  <Screenshot>https://raw.githubusercontent.com/snapetech-org/slskr/main/docs/screenshots/webui-searches.png</Screenshot>
  <Screenshot>https://raw.githubusercontent.com/snapetech-org/slskr/main/docs/screenshots/webui-downloads.png</Screenshot>
  <Networking>
    <Mode>bridge</Mode>
    <Port>
      <HostPort>5030</HostPort>
      <ContainerPort>5030</ContainerPort>
      <Protocol>tcp</Protocol>
    </Port>
    <Port>
      <HostPort>2234</HostPort>
      <ContainerPort>2234</ContainerPort>
      <Protocol>tcp</Protocol>
    </Port>
  </Networking>
  <Environment>
    <Variable>
      <Name>SLSKR_HTTP_BIND</Name>
      <Value>0.0.0.0:5030</Value>
    </Variable>
    <Variable>
      <Name>SLSKR_SHARE_DIRS</Name>
      <Value>/app/shares</Value>
    </Variable>
    <Variable>
      <Name>SLSKR_DOWNLOADS_DIR</Name>
      <Value>/app/downloads</Value>
    </Variable>
    <Variable>
      <Name>SLSKR_INCOMPLETE_DIR</Name>
      <Value>/app/incomplete</Value>
    </Variable>
    <Variable>
      <Name>SLSKR_DOWNLOAD_FILTER_EXCLUDE</Name>
      <Value></Value>
    </Variable>
    <Variable>
      <Name>SLSKR_API_TOKEN</Name>
      <Value></Value>
    </Variable>
    <Variable>
      <Name>SLSKD_PASSWORD</Name>
      <Value></Value>
    </Variable>
  </Environment>
  <Data>
    <Config Name="Downloads" Target="/app/downloads" Default="/mnt/user/data/slskr/downloads" Mode="rw" />
    <Config Name="Incomplete" Target="/app/incomplete" Default="/mnt/user/data/slskr/incomplete" Mode="rw" />
    <Config Name="Shares" Target="/app/shares" Default="/mnt/user/data/slskr/shares" Mode="ro" />
    <Config Name="State" Target="/var/lib/slskr" Default="/mnt/user/appdata/slskr/state" Mode="rw" />
  </Data>
  <ExtraParams>--restart=unless-stopped</ExtraParams>
  <PostArgs />
</Container>
